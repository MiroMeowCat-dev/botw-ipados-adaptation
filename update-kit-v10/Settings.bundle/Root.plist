<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>画面</string>
			<key>FooterText</key>
			<string>画面和帧率选项保存后，需从多任务退出游戏再重新打开。屏幕输出以1080p场景放大，支持普通缩放和MetalFX空间超分。</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>分辨率与放大</string>
			<key>Key</key>
			<string>BOTW_IPAD_DISPLAY_PROFILE</string>
			<key>DefaultValue</key>
			<string>1080</string>
			<key>Values</key>
			<array>
				<string>legacy</string>
				<string>1080</string>
				<string>panel</string>
				<string>panel-mfx</string>
			</array>
			<key>Titles</key>
			<array>
				<string>兼容 · 540p场景</string>
				<string>1080p游戏区域</string>
				<string>1080p → 屏幕 · 普通放大</string>
				<string>1080p → 屏幕 · MetalFX</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>画面比例</string>
			<key>Key</key>
			<string>BOTW_IPAD_ASPECT</string>
			<key>DefaultValue</key>
			<string>16:9</string>
			<key>Values</key>
			<array>
				<string>16:9</string>
				<string>screen</string>
			</array>
			<key>Titles</key>
			<array>
				<string>16:9 · 保留黑边</string>
				<string>11英寸iPad全屏取景</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>帧率上限</string>
			<key>Key</key>
			<string>BOTW_IPAD_FRAME_CAP</string>
			<key>DefaultValue</key>
			<string>auto</string>
			<key>Values</key>
			<array>
				<string>auto</string>
				<string>30</string>
				<string>60</string>
			</array>
			<key>Titles</key>
			<array>
				<string>跟随游戏</string>
				<string>30帧</string>
				<string>60帧</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>背包</string>
			<key>FooterText</key>
			<string>自动兼容：全屏取景时，进入背包使用16:9，退出后恢复全屏。固定全屏可能仍有菜单错位。</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>背包显示</string>
			<key>Key</key>
			<string>BOTW_MENU_DISPLAY_MODE</string>
			<key>DefaultValue</key>
			<string>auto</string>
			<key>Values</key>
			<array>
				<string>auto</string>
				<string>16:9</string>
				<string>fullscreen</string>
			</array>
			<key>Titles</key>
			<array>
				<string>自动兼容（推荐）</string>
				<string>固定16:9</string>
				<string>保持全屏</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>体感</string>
			<key>FooterText</key>
			<string>使用iPad自身传感器。请同时开启游戏选项里的体感瞄准；重新校准时保持设备平稳。</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>iPad体感瞄准</string>
			<key>Key</key>
			<string>BOTW_IPAD_GYRO_ENABLED</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>虚拟手柄</string>
			<key>FooterText</key>
			<string>布局编辑可拖动按键和摇杆，并调整大小与透明度；保存后保留在本机。编辑前请先在游戏内暂停。</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>显示虚拟手柄</string>
			<key>Key</key>
			<string>BOTW_TOUCH_VISIBLE</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>使用自定义布局</string>
			<key>Key</key>
			<string>BOTW_TOUCH_EDITOR_ENABLED</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>界面</string>
			<key>FooterText</key>
			<string>隐藏设置入口后，可在系统「设置 → App → 塞尔达」重新开启。性能信息的更改重开游戏后生效。</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>显示游戏内设置入口</string>
			<key>Key</key>
			<string>BOTW_SETTINGS_BUTTON</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>显示性能信息</string>
			<key>Key</key>
			<string>BOTW_IPAD_PERFORMANCE_DISPLAY</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>语言</string>
			<key>FooterText</key>
			<string>游戏语言的更改重开游戏后生效。</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>游戏语言</string>
			<key>Key</key>
			<string>TOTK_LANG</string>
			<key>DefaultValue</key>
			<string></string>
			<key>Values</key>
			<array>
				<string></string>
				<string>zh-Hant</string>
				<string>zh-Hans</string>
				<string>en-US</string>
				<string>ja</string>
				<string>de</string>
				<string>es</string>
				<string>fr</string>
				<string>it</string>
				<string>nl</string>
				<string>ru</string>
				<string>ko</string>
			</array>
			<key>Titles</key>
			<array>
				<string>跟随系统</string>
				<string>繁體中文</string>
				<string>简体中文</string>
				<string>English</string>
				<string>日本語</string>
				<string>Deutsch</string>
				<string>Español</string>
				<string>Français</string>
				<string>Italiano</string>
				<string>Nederlands</string>
				<string>Русский</string>
				<string>한국어</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>高级</string>
			<key>FooterText</key>
			<string>诊断记录只保存在本机，通常无需开启。布局编辑和体感校准请从游戏内设置操作。</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>记录诊断日志</string>
			<key>Key</key>
			<string>TOTK_DEBUG_LOG</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>本地运行记录</string>
			<key>Key</key>
			<string>BOTW_IPAD_LOCAL_DIAGNOSTICS</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
	</array>
</dict>
</plist>
